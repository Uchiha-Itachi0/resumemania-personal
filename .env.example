# Copy this file to .env and fill in your key. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fast, cheap model: reads the resume and the job description.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# Model for the thinking steps: matches evidence, reviews writing, writes your plan.
GEMINI_MODEL_SMART=gemini-3.5-flash-lite
# For deeper answers, use gemini-3.8-flash once Google fixes its capacity issues (503/504 errors):
# GEMINI_MODEL_SMART=gemini-3.8-flash
# Tried in order when a model above is busy, rate limited or too slow. Leave empty to turn off.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite
# Give up on one AI call after this many seconds and try the next model.
GEMINI_TIMEOUT_SECONDS=45

# Optional
# RESUMEMANIA_DB_PATH=data/resumemania.db
# RESUMEMANIA_MAX_UPLOAD_MB=5
